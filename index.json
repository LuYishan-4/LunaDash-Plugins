{
  "schemaVersion": 1,
  "format": "lunadash-plugin-index",
  "plugins": [
    {
      "id": "org.lunadash.digitalclock",
      "name": "Digital Clock",
      "description": "A configurable desktop-layer digital clock for LunaDash that stays behind application windows.",
      "version": "2.1.0",
      "author": "LuYishan",
      "icon": "clock",
      "targets": [
        {
          "id": "desktop-widgets",
          "target": "desktop-widgets",
          "type": "quickshell",
          "mode": "augment",
          "settings": {
            "position": {
              "type": "string",
              "control": "select",
              "label": "Position",
              "default": "bottomRight",
              "enum": [
                "topLeft",
                "topRight",
                "bottomLeft",
                "bottomRight"
              ]
            },
            "marginX": {
              "type": "integer",
              "control": "number",
              "label": "Horizontal margin",
              "default": 34,
              "minimum": 0,
              "maximum": 240,
              "step": 1
            },
            "marginY": {
              "type": "integer",
              "control": "number",
              "label": "Vertical margin",
              "default": 34,
              "minimum": 0,
              "maximum": 240,
              "step": 1
            },
            "use24Hour": {
              "type": "boolean",
              "control": "toggle",
              "label": "Use 24-hour time",
              "default": true
            },
            "showSeconds": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show seconds",
              "default": false
            },
            "showDate": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show date",
              "default": true
            },
            "scale": {
              "type": "number",
              "control": "slider",
              "label": "Clock scale",
              "default": 1,
              "minimum": 0.7,
              "maximum": 1.5,
              "step": 0.05
            },
            "opacity": {
              "type": "number",
              "control": "slider",
              "label": "Opacity",
              "default": 1,
              "minimum": 0.3,
              "maximum": 1,
              "step": 0.05
            }
          }
        }
      ],
      "tags": [
        "Widget",
        "Clock",
        "Desktop"
      ],
      "sourceUrl": "https://github.com/LuYishan-4/LunaDash-Plugins/tree/main/plugins/org.lunadash.digitalclock",
      "siteUrl": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.digitalclock/",
      "license": "GPL-3.0-or-later",
      "repository": "https://github.com/LuYishan-4/LunaDash-Plugins",
      "featured": true,
      "deprecated": false,
      "type": "quickshell",
      "target": "desktop-widgets",
      "mode": "augment",
      "settings": {
        "position": {
          "type": "string",
          "control": "select",
          "label": "Position",
          "default": "bottomRight",
          "enum": [
            "topLeft",
            "topRight",
            "bottomLeft",
            "bottomRight"
          ]
        },
        "marginX": {
          "type": "integer",
          "control": "number",
          "label": "Horizontal margin",
          "default": 34,
          "minimum": 0,
          "maximum": 240,
          "step": 1
        },
        "marginY": {
          "type": "integer",
          "control": "number",
          "label": "Vertical margin",
          "default": 34,
          "minimum": 0,
          "maximum": 240,
          "step": 1
        },
        "use24Hour": {
          "type": "boolean",
          "control": "toggle",
          "label": "Use 24-hour time",
          "default": true
        },
        "showSeconds": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show seconds",
          "default": false
        },
        "showDate": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show date",
          "default": true
        },
        "scale": {
          "type": "number",
          "control": "slider",
          "label": "Clock scale",
          "default": 1,
          "minimum": 0.7,
          "maximum": 1.5,
          "step": 0.05
        },
        "opacity": {
          "type": "number",
          "control": "slider",
          "label": "Opacity",
          "default": 1,
          "minimum": 0.3,
          "maximum": 1,
          "step": 0.05
        }
      },
      "homepage": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.digitalclock/",
      "install": {
        "mode": "cmake",
        "files": [
          {
            "path": "metadata.json",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.digitalclock/metadata.json",
            "sha256": "22184d23cfce6c3499fbdf06aa38fcfd2394ac0dafdf4a8b86ac172a0953e097"
          },
          {
            "path": "CMakeLists.txt",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.digitalclock/CMakeLists.txt",
            "sha256": "a52094a85ad4e4baeb1da7797ec45705ab8c1932afd457da3f91b9cfe4fc15ab"
          },
          {
            "path": "Main.qml",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.digitalclock/Main.qml",
            "sha256": "e8a7811cac7024e7c6eb6f6d86a1181147cb6d99a42914e87fe2f406bd14aafe"
          }
        ]
      }
    },
    {
      "id": "org.lunadash.kde-behavior",
      "name": "KDE Behavior Pack",
      "description": "KDE-inspired floating panel, freeform window layout, window rules and animations packaged as one multi-target LunaDash plugin.",
      "version": "2.0.0",
      "author": "LunaDash contributors",
      "icon": "preferences-desktop",
      "targets": [
        {
          "id": "panel",
          "target": "panel",
          "type": "quickshell",
          "mode": "replace",
          "settings": {
            "compact": {
              "type": "boolean",
              "control": "toggle",
              "label": "Compact task buttons",
              "default": true
            },
            "showLabels": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show window titles",
              "default": false
            },
            "showWorkspaceSwitcher": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show workspace switcher",
              "default": true
            },
            "showSystemTray": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show system tray",
              "default": true
            },
            "showStatus": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show status controls",
              "default": true
            },
            "showClock": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show clock",
              "default": true
            },
            "iconSize": {
              "type": "integer",
              "control": "slider",
              "label": "Dock icon size",
              "default": 22,
              "minimum": 16,
              "maximum": 32,
              "step": 1
            },
            "panelOpacity": {
              "type": "number",
              "control": "slider",
              "label": "Capsule opacity",
              "default": 0.88,
              "minimum": 0.45,
              "maximum": 1,
              "step": 0.01
            }
          }
        },
        {
          "id": "window-layout",
          "target": "window-layout",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "placement": {
              "type": "string",
              "control": "select",
              "label": "New window placement",
              "default": "cascade",
              "enum": [
                "cascade",
                "center"
              ]
            },
            "cascadeOffset": {
              "type": "integer",
              "control": "slider",
              "label": "Cascade offset",
              "default": 28,
              "minimum": 0,
              "maximum": 80,
              "step": 1
            }
          }
        },
        {
          "id": "window-rules",
          "target": "window-rules",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "workspacePolicy": {
              "type": "string",
              "control": "select",
              "label": "New-window workspace policy",
              "default": "current",
              "enum": [
                "current",
                "first",
                "remember"
              ]
            },
            "maximizeNewWindows": {
              "type": "boolean",
              "control": "toggle",
              "label": "Maximize new windows",
              "default": false
            }
          }
        },
        {
          "id": "window-animation",
          "target": "window-animation",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "duration": {
              "type": "integer",
              "control": "number",
              "label": "Animation duration",
              "default": 180,
              "minimum": 0,
              "maximum": 600,
              "step": 10
            },
            "enterOffset": {
              "type": "integer",
              "control": "number",
              "label": "Opening offset",
              "default": 6,
              "minimum": -100,
              "maximum": 100,
              "step": 1
            },
            "focusOpacity": {
              "type": "number",
              "control": "slider",
              "label": "Unfocused opacity",
              "default": 0.96,
              "minimum": 0,
              "maximum": 1,
              "step": 0.01
            },
            "exitScale": {
              "type": "number",
              "control": "slider",
              "label": "Closing scale",
              "default": 0.97,
              "minimum": 0.5,
              "maximum": 1,
              "step": 0.01
            },
            "easing": {
              "type": "string",
              "control": "select",
              "label": "Easing curve",
              "default": "outCubic",
              "enum": [
                "linear",
                "outCubic",
                "outQuint",
                "inOutCubic"
              ]
            }
          }
        }
      ],
      "tags": [
        "KDE",
        "Panel",
        "Freeform",
        "Windows",
        "Animation",
        "Multi-target"
      ],
      "sourceUrl": "https://github.com/LuYishan-4/LunaDash-Plugins/tree/main/plugins/org.lunadash.kde-behavior",
      "siteUrl": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.kde-behavior/",
      "license": "GPL-3.0-or-later",
      "repository": "https://github.com/LuYishan-4/LunaDash-Plugins",
      "featured": true,
      "deprecated": false,
      "homepage": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.kde-behavior/",
      "install": {
        "mode": "cmake",
        "files": [
          {
            "path": "metadata.json",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/metadata.json",
            "sha256": "a915e58e7ef821c47556584314ef8eea23dcebc1c88c1a35d3461685f5887500"
          },
          {
            "path": "CMakeLists.txt",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/CMakeLists.txt",
            "sha256": "688a2fa689a509370325de4bc79b8c47a1aa98cbd240bd3095f349f6490a43ef"
          },
          {
            "path": "Effect.cpp",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/Effect.cpp",
            "sha256": "5e9f966058b0e10abda5babab7b23cbef1a3aa288496d2576672c47ee0b9a71d"
          },
          {
            "path": "KdePanel.qml",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/KdePanel.qml",
            "sha256": "46c1ed5eb7663a5666c7507c964f4139ce4826a5dfc81353b6e3fa80d48d5279"
          }
        ]
      }
    }
  ]
}

{
  "schemaVersion": 1,
  "format": "lunadash-plugin-index",
  "plugins": [
    {
      "id": "org.lunadash.audio-wave",
      "name": "Audio Wave",
      "description": "A wallpaper audio visualizer that animates only while media is playing and scales with the current desktop output volume.",
      "version": "1.0.1a",
      "author": "LunaDash contributors",
      "icon": "audio-x-generic",
      "targets": [
        {
          "id": "desktop-widgets",
          "target": "desktop-widgets",
          "type": "quickshell",
          "mode": "augment",
          "settings": {
            "barCount": {
              "type": "integer",
              "control": "slider",
              "label": "Bar count",
              "default": 72,
              "minimum": 24,
              "maximum": 120,
              "step": 4
            },
            "height": {
              "type": "integer",
              "control": "slider",
              "label": "Visualizer height",
              "default": 210,
              "minimum": 80,
              "maximum": 420,
              "step": 10
            },
            "bottomMargin": {
              "type": "integer",
              "control": "slider",
              "label": "Bottom margin",
              "default": 0,
              "minimum": 0,
              "maximum": 240,
              "step": 4
            },
            "opacity": {
              "type": "number",
              "control": "slider",
              "label": "Opacity",
              "default": 0.78,
              "minimum": 0.15,
              "maximum": 1,
              "step": 0.01
            },
            "sensitivity": {
              "type": "number",
              "control": "slider",
              "label": "Volume sensitivity",
              "default": 1.15,
              "minimum": 0.4,
              "maximum": 2,
              "step": 0.05
            },
            "mirror": {
              "type": "boolean",
              "control": "toggle",
              "label": "Mirror wave profile",
              "default": true
            }
          }
        }
      ],
      "tags": [
        "Audio",
        "Visualizer",
        "Wallpaper",
        "Desktop"
      ],
      "sourceUrl": "https://github.com/LuYishan-4/LunaDash-Plugins/tree/main/plugins/org.lunadash.audio-wave",
      "siteUrl": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.audio-wave/",
      "license": "GPL-3.0-or-later",
      "repository": "https://github.com/LuYishan-4/LunaDash-Plugins",
      "featured": true,
      "deprecated": false,
      "type": "quickshell",
      "target": "desktop-widgets",
      "mode": "augment",
      "settings": {
        "barCount": {
          "type": "integer",
          "control": "slider",
          "label": "Bar count",
          "default": 72,
          "minimum": 24,
          "maximum": 120,
          "step": 4
        },
        "height": {
          "type": "integer",
          "control": "slider",
          "label": "Visualizer height",
          "default": 210,
          "minimum": 80,
          "maximum": 420,
          "step": 10
        },
        "bottomMargin": {
          "type": "integer",
          "control": "slider",
          "label": "Bottom margin",
          "default": 0,
          "minimum": 0,
          "maximum": 240,
          "step": 4
        },
        "opacity": {
          "type": "number",
          "control": "slider",
          "label": "Opacity",
          "default": 0.78,
          "minimum": 0.15,
          "maximum": 1,
          "step": 0.01
        },
        "sensitivity": {
          "type": "number",
          "control": "slider",
          "label": "Volume sensitivity",
          "default": 1.15,
          "minimum": 0.4,
          "maximum": 2,
          "step": 0.05
        },
        "mirror": {
          "type": "boolean",
          "control": "toggle",
          "label": "Mirror wave profile",
          "default": true
        }
      },
      "homepage": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.audio-wave/",
      "install": {
        "mode": "cmake",
        "files": [
          {
            "path": "metadata.json",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.audio-wave/metadata.json",
            "sha256": "d079a3f7eb9c71593348f42496358849ae28f6af6e91cb207a67b9e92d5b5693"
          },
          {
            "path": "CMakeLists.txt",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.audio-wave/CMakeLists.txt",
            "sha256": "ea05b0de1e3c4906cce499c489950617f528216fb4f61a231c1e33fdbbab92e3"
          },
          {
            "path": "Main.qml",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.audio-wave/Main.qml",
            "sha256": "31eb7255084055ee36f23df0415f8e58853f287533591e891fbe81fc57d5cbc9"
          }
        ]
      }

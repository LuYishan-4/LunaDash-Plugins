        ]
      }
    },
    {
      "id": "org.lunadash.kde-behavior",
      "name": "KDE Behavior Pack",
      "description": "KDE-inspired floating capsules, freeform windows, dashboard access, system status, window rules and animations for LunaDash.",
      "version": "1.0.1a",
      "author": "LunaDash contributors",
      "icon": "preferences-desktop",
      "targets": [
        {
          "id": "panel",
          "target": "panel",
          "type": "quickshell",
          "mode": "replace",
          "settings": {
            "compact": {
              "type": "boolean",
              "control": "toggle",
              "label": "Compact task buttons",
              "default": true
            },
            "showLabels": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show window titles",
              "default": false
            },
            "showWorkspaceSwitcher": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show workspace switcher",
              "default": true
            },
            "showSystemTray": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show system tray",
              "default": true
            },
            "showStatus": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show status controls",
              "default": true
            },
            "showClock": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show clock",
              "default": true
            },
            "iconSize": {
              "type": "integer",
              "control": "slider",
              "label": "Dock icon size",
              "default": 22,
              "minimum": 16,
              "maximum": 32,
              "step": 1
            },
            "panelOpacity": {
              "type": "number",
              "control": "slider",
              "label": "Capsule opacity",
              "default": 0.88,
              "minimum": 0.45,
              "maximum": 1,
              "step": 0.01
            },
            "showDashboard": {
              "type": "boolean",
              "control": "toggle",
              "label": "Show dashboard button",
              "default": true
            }
          }
        },
        {
          "id": "window-layout",
          "target": "window-layout",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "placement": {
              "type": "string",
              "control": "select",
              "label": "New window placement",
              "default": "cascade",
              "enum": [
                "cascade",
                "center"
              ]
            },
            "cascadeOffset": {
              "type": "integer",
              "control": "slider",
              "label": "Cascade offset",
              "default": 28,
              "minimum": 0,
              "maximum": 80,
              "step": 1
            }
          }
        },
        {
          "id": "window-rules",
          "target": "window-rules",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "workspacePolicy": {
              "type": "string",
              "control": "select",
              "label": "New-window workspace policy",
              "default": "current",
              "enum": [
                "current",
                "first",
                "remember"
              ]
            },
            "maximizeNewWindows": {
              "type": "boolean",
              "control": "toggle",
              "label": "Maximize new windows",
              "default": false
            }
          }
        },
        {
          "id": "window-animation",
          "target": "window-animation",
          "type": "effect",
          "mode": "replace",
          "settings": {
            "duration": {
              "type": "integer",
              "control": "number",
              "label": "Animation duration",
              "default": 180,
              "minimum": 0,
              "maximum": 600,
              "step": 10
            },
            "enterOffset": {
              "type": "integer",
              "control": "number",
              "label": "Opening offset",
              "default": 6,
              "minimum": -100,
              "maximum": 100,
              "step": 1
            },
            "focusOpacity": {
              "type": "number",
              "control": "slider",
              "label": "Unfocused opacity",
              "default": 0.96,
              "minimum": 0,
              "maximum": 1,
              "step": 0.01
            },
            "exitScale": {
              "type": "number",
              "control": "slider",
              "label": "Closing scale",
              "default": 0.97,
              "minimum": 0.5,
              "maximum": 1,
              "step": 0.01
            },
            "easing": {
              "type": "string",
              "control": "select",
              "label": "Easing curve",
              "default": "outCubic",
              "enum": [
                "linear",
                "outCubic",
                "outQuint",
                "inOutCubic"
              ]
            }
          }
        }
      ],
      "tags": [
        "KDE",
        "Panel",
        "Freeform",
        "Windows",
        "Animation",
        "Multi-target"
      ],
      "sourceUrl": "https://github.com/LuYishan-4/LunaDash-Plugins/tree/main/plugins/org.lunadash.kde-behavior",
      "siteUrl": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.kde-behavior/",
      "license": "GPL-3.0-or-later",
      "repository": "https://github.com/LuYishan-4/LunaDash-Plugins",
      "featured": true,
      "deprecated": false,
      "homepage": "https://luyishan-4.github.io/LunaDash-Plugins/plugins/org.lunadash.kde-behavior/",
      "install": {
        "mode": "cmake",
        "files": [
          {
            "path": "metadata.json",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/metadata.json",
            "sha256": "424c8a9ec421942e738a25f86742e5f7fea302d85cd35fe8a4d499808fbefd26"
          },
          {
            "path": "CMakeLists.txt",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/CMakeLists.txt",
            "sha256": "f3c29207847782189f8dc382dab8ecac10789d2792853165becf13cbc419dfc0"
          },
          {
            "path": "Effect.cpp",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/Effect.cpp",
            "sha256": "5e9f966058b0e10abda5babab7b23cbef1a3aa288496d2576672c47ee0b9a71d"
          },
          {
            "path": "KdePanel.qml",
            "url": "https://raw.githubusercontent.com/LuYishan-4/LunaDash-Plugins/main/plugins/org.lunadash.kde-behavior/KdePanel.qml",
            "sha256": "c6c95374466799161ff1d6724dbacfb715e72d26dd264dc4983a99080ab0ea53"
          }
        ]
      }
    }
  ]
}

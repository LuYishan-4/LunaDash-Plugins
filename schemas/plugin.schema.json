{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luyishan-4.github.io/LunaDash-Plugins/schemas/plugin.schema.json",
  "title": "LunaDash Plugin SDK 2 Manifest",
  "description": "Editor aid only. CI uses contracts/ValidatePlugin.py as the authoritative validator.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sdk",
    "id",
    "name",
    "version"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sdk": {
      "type": "object",
      "required": [
        "name",
        "apiVersion"
      ],
      "properties": {
        "name": {
          "const": "LunaDash"
        },
        "apiVersion": {
          "const": 2
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "icon": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "enabledByDefault": {
      "type": "boolean"
    },
    "type": {
      "enum": [
        "quickshell",
        "effect",
        "opengl"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "replace",
        "augment"
      ]
    },
    "entry": {
      "type": "string"
    },
    "shaders": {
      "type": "object"
    },
    "windowTemplate": {
      "enum": [
        "tiling",
        "stacking"
      ]
    },
    "settings": {
      "type": "object"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "type",
          "target",
          "mode",
          "settings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "quickshell",
              "effect",
              "opengl"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "replace",
              "augment"
            ]
          },
          "entry": {
            "type": "string"
          },
          "shaders": {
            "type": "object"
          },
          "windowTemplate": {
            "enum": [
              "tiling",
              "stacking"
            ]
          },
          "settings": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "type",
        "target",
        "mode",
        "settings"
      ]
    },
    {
      "required": [
        "targets"
      ]
    }
  ],
  "additionalProperties": true
}

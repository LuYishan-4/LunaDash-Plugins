---
import Base from "../../layouts/Base.astro";
import { plugins, targetMap } from "../../data/catalog";

export function getStaticPaths() {
  return plugins.map(plugin => ({
    params: { id: plugin.id },
    props: { plugin }
  }));
}

const { plugin } = Astro.props;
const item = plugin as any;
const base = import.meta.env.BASE_URL;
const targetEntries: Array<{
  target:string;
  type:string;
  mode:string;
  settings?:Record<string, unknown>;
}> = (item.targets?.length ? item.targets : [{
  target: item.target,
  type: item.type,
  mode: item.mode,
  settings: item.settings || {}
}]);
const types = [...new Set(targetEntries.map(entry => entry.type))];
const iconIsImage = String(plugin.icon || "").startsWith("https://");
---
<Base title={plugin.name} description={plugin.description}>
  <section class="detail">
    <a class="back" href={base}>← All plugins</a>
    <div class="detail-head">
      <div class="plugin-icon large">
        {iconIsImage ? <img src={plugin.icon} alt="" /> : <span>{plugin.name.slice(0, 1).toUpperCase()}</span>}
      </div>
      <div class="detail-title">
        <div class="badges">
          {types.map(type => <span class:list={["badge", type]}>{type}</span>)}
          {plugin.featured && <span class="badge featured">featured</span>}
          {plugin.deprecated && <span class="badge danger">deprecated</span>}
        </div>
        <h1>{plugin.name}</h1>
        <p>{plugin.description}</p>
      </div>
    </div>

    <div class="detail-grid">
      <article class="panel">
        <h2>About</h2>
        <dl>
          <div><dt>ID</dt><dd><code>{plugin.id}</code></dd></div>
          <div><dt>Version</dt><dd>{plugin.version}</dd></div>
          <div><dt>Author</dt><dd>{plugin.author || "Unknown"}</dd></div>
          <div><dt>Targets</dt><dd>{targetEntries.length}</dd></div>
          <div><dt>License</dt><dd>{plugin.license}</dd></div>
        </dl>
        <div class="hero-actions">
          <a class="button primary" href={plugin.sourceUrl}>View source</a>
          <a class="button" href={plugin.repository}>Project repository</a>
        </div>
      </article>

      <article class="panel">
        <h2>Target implementations</h2>
        <div class="setting-list">
          {targetEntries.map(entry => {
            const target = targetMap.get(entry.target);
            return (
              <div class="setting-row">
                <div>
                  <strong>{target?.name || entry.target}</strong>
                  <code>{entry.target}</code>
                </div>
                <span>{entry.type} · {entry.mode}</span>
              </div>
            );
          })}
        </div>
      </article>
    </div>

    {targetEntries.map(entry => {
      const settings = Object.entries(entry.settings || {});
      const target = targetMap.get(entry.target);
      return (
        <article class="panel">
          <h2>{target?.name || entry.target} settings</h2>
          {settings.length ? (
            <div class="setting-list">
              {settings.map(([key, raw]) => {
                const rule = raw as Record<string, any>;
                const inferred = rule.control ||
                  (rule.enum ? "select" :
                   rule.type === "boolean" ? "toggle" :
                   (rule.type === "integer" || rule.type === "number") &&
                     "minimum" in rule && "maximum" in rule ? "slider" :
                   rule.type === "string" ? "text" : "number");
                return (
                  <div class="setting-row">
                    <div><strong>{rule.label || key}</strong><code>{key}</code></div>
                    <span>{inferred}</span>
                  </div>
                );
              })}
            </div>
          ) : <p class="muted">This target does not expose configurable options.</p>}
        </article>
      );
    })}

    <article class="panel security-note">
      <h2>Trust boundary</h2>
      <p>{types.includes("effect")
        ? "This package contains native compositor code. LunaDash requires native packages to default to disabled; inspect the source before enabling it."
        : types.includes("opengl")
          ? "This package runs shader code in supported visual slots. Software rendering keeps the built-in feature."
          : "This Quickshell package executes as your desktop user. Registry validation checks its package contract but does not sandbox the code."}</p>
    </article>
  </section>
</Base>

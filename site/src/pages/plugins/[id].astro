---
import Base from "../../layouts/Base.astro";
import { plugins, targetMap } from "../../data/catalog";

export function getStaticPaths() {
  return plugins.map(plugin => ({
    params: { id: plugin.id },
    props: { plugin }
  }));
}

const { plugin } = Astro.props;
const target = targetMap.get(plugin.target);
const base = import.meta.env.BASE_URL;
const settings = Object.entries(plugin.settings || {});
const iconIsImage = String(plugin.icon || "").startsWith("https://");
---
<Base title={plugin.name} description={plugin.description}>
  <section class="detail">
    <a class="back" href={base}>← All plugins</a>
    <div class="detail-head">
      <div class="plugin-icon large">
        {iconIsImage ? <img src={plugin.icon} alt="" /> : <span>{plugin.name.slice(0, 1).toUpperCase()}</span>}
      </div>
      <div class="detail-title">
        <div class="badges">
          <span class:list={["badge", plugin.type]}>{plugin.type}</span>
          {plugin.featured && <span class="badge featured">featured</span>}
          {plugin.deprecated && <span class="badge danger">deprecated</span>}
        </div>
        <h1>{plugin.name}</h1>
        <p>{plugin.description}</p>
      </div>
    </div>

    <div class="detail-grid">
      <article class="panel">
        <h2>About</h2>
        <dl>
          <div><dt>ID</dt><dd><code>{plugin.id}</code></dd></div>
          <div><dt>Version</dt><dd>{plugin.version}</dd></div>
          <div><dt>Author</dt><dd>{plugin.author || "Unknown"}</dd></div>
          <div><dt>Target</dt><dd>{target?.name || plugin.target} <code>{plugin.target}</code></dd></div>
          <div><dt>Mode</dt><dd>{plugin.mode}</dd></div>
          <div><dt>License</dt><dd>{plugin.license}</dd></div>
        </dl>
        <div class="hero-actions">
          <a class="button primary" href={plugin.sourceUrl}>View source</a>
          <a class="button" href={plugin.repository}>Project repository</a>
        </div>
      </article>

      <article class="panel">
        <h2>Settings schema</h2>
        {settings.length ? (
          <div class="setting-list">
            {settings.map(([key, raw]) => {
              const rule = raw as Record<string, any>;
              const inferred = rule.control ||
                (rule.enum ? "select" :
                 rule.type === "boolean" ? "toggle" :
                 (rule.type === "integer" || rule.type === "number") &&
                   "minimum" in rule && "maximum" in rule ? "slider" :
                 rule.type === "string" ? "text" : "number");
              return (
                <div class="setting-row">
                  <div><strong>{rule.label || key}</strong><code>{key}</code></div>
                  <span>{inferred}</span>
                </div>
              );
            })}
          </div>
        ) : <p class="muted">This plugin does not expose configurable options.</p>}
      </article>
    </div>

    <article class="panel security-note">
      <h2>Trust boundary</h2>
      <p>{plugin.type === "effect"
        ? "This is native compositor code. LunaDash requires native effects to default to disabled; inspect the source before enabling it."
        : plugin.type === "opengl"
          ? "This plugin runs shader code in a supported Qt Quick visual slot. Software rendering keeps the built-in feature."
          : "This Quickshell plugin executes as your desktop user. Registry validation checks its package contract but does not sandbox the code."}</p>
    </article>
  </section>
</Base>

---
import Base from "../layouts/Base.astro";
import { plugins, targetMap } from "../data/catalog";
const base = import.meta.env.BASE_URL;
const types = ["all", "quickshell", "effect", "opengl"];
---
<Base>
  <section class="hero">
    <div>
      <span class="eyebrow">LunaDash Plugin SDK 2</span>
      <h1>Extend the desktop,<br /><span>without forking it.</span></h1>
      <p>Browse community extensions for LunaDash. A package can own multiple targets, and every target is checked against LunaDash's runtime contract.</p>
      <div class="hero-actions">
        <a class="button primary" href={base + "submit/"}>Submit a plugin</a>
        <a class="button" href="https://github.com/LuYishan-4/LunaDash-Plugins/blob/main/CONTRIBUTING.md">Read the rules</a>
      </div>
    </div>
    <div class="hero-orbit" aria-hidden="true">
      <span>QML</span><span>C++</span><span>GLSL</span>
    </div>
  </section>

  <section class="browser">
    <div class="section-heading">
      <div><span class="eyebrow">Registry</span><h2>Plugins</h2></div>
      <span class="count">{plugins.length} published</span>
    </div>

    <div class="toolbar">
      <label class="search">
        <span>⌕</span>
        <input id="plugin-search" type="search" placeholder="Search name, target, author, tag…" autocomplete="off" />
      </label>
      <div class="type-filters" aria-label="Filter by type">
        {types.map((type, index) => (
          <button class:list={["filter", { active: index === 0 }]} data-type={type}>
            {type === "all" ? "All" : type}
          </button>
        ))}
      </div>
    </div>

    <div class="plugin-grid" id="plugin-grid">
      {plugins.map(plugin => {
        const entries = (plugin.targets?.length ? plugin.targets : [{
          target: plugin.target, type: plugin.type, mode: plugin.mode
        }]);
        const pluginTypes = [...new Set(entries.map(entry => entry.type))];
        const targetNames = entries.map(entry => targetMap.get(entry.target)?.name || entry.target);
        const iconIsImage = String(plugin.icon || "").startsWith("https://");
        const search = [
          plugin.name, plugin.id, plugin.description, plugin.author,
          ...pluginTypes, ...targetNames, ...entries.map(entry => entry.target),
          ...(plugin.tags || [])
        ].join(" ").toLowerCase();
        return (
          <article class="plugin-card" data-types={pluginTypes.join(" ")} data-search={search}>
            <a class="card-link" href={base + "plugins/" + plugin.id + "/"} aria-label={"Open " + plugin.name}></a>
            <div class="card-top">
              <div class="plugin-icon">
                {iconIsImage ? <img src={plugin.icon} alt="" loading="lazy" /> : <span>{plugin.name.slice(0, 1).toUpperCase()}</span>}
              </div>
              <div class="badges">
                {pluginTypes.map(type => <span class:list={["badge", type]}>{type}</span>)}
                {plugin.featured && <span class="badge featured">featured</span>}
              </div>
            </div>
            <h3>{plugin.name}</h3>
            <p>{plugin.description}</p>
            <div class="meta">
              <span>{entries.length === 1 ? targetNames[0] : entries.length + " targets"}</span>
              <span>v{plugin.version}</span>
            </div>
            <div class="tags">
              {(plugin.tags || []).map(tag => <span>#{tag}</span>)}
            </div>
          </article>
        );
      })}
    </div>
    <p class="empty" id="empty-state" hidden>No plugins match this search.</p>
  </section>

  <section class="contract-strip">
    <div><strong>3</strong><span>SDK types</span></div>
    <div><strong>{targetMap.size}</strong><span>registered targets</span></div>
    <div><strong>SDK 2</strong><span>shared validation contract</span></div>
  </section>

  <script is:inline>
    const search = document.querySelector("#plugin-search");
    const buttons = [...document.querySelectorAll(".filter")];
    const cards = [...document.querySelectorAll(".plugin-card")];
    const empty = document.querySelector("#empty-state");
    let type = "all";

    function apply() {
      const query = (search?.value || "").trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const typeOk = type === "all" || (card.dataset.types || "").split(" ").includes(type);
        const textOk = !query || (card.dataset.search || "").includes(query);
        card.hidden = !(typeOk && textOk);
        if (!card.hidden) shown++;
      }
      if (empty) empty.hidden = shown !== 0;
    }

    search?.addEventListener("input", apply);
    for (const button of buttons) {
      button.addEventListener("click", () => {
        type = button.dataset.type || "all";
        buttons.forEach(item => item.classList.toggle("active", item === button));
        apply();
      });
    }
  </script>
</Base>

{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.lunadash.audio-wave",
  "name": "Audio Wave",
  "name[zh_TW]": "音訊波浪",
  "description": "A smoother wallpaper audio visualizer with higher gain, 60 FPS interpolation, and playback-aware amplitude.",
  "description[zh_TW]": "更流暢的桌布音訊視覺化插件；提高增益並以 60 FPS 插值，播放時振幅更明顯，停止時平滑收斂。",
  "version": "1.0.1a",
  "author": {
    "name": "LunaDash contributors"
  },
  "icon": "audio-x-generic",
  "tags": [
    "Audio",
    "Visualizer",
    "Wallpaper",
    "Desktop"
  ],
  "enabledByDefault": false,
  "targets": [
    {
      "id": "desktop-widgets",
      "type": "quickshell",
      "target": "desktop-widgets",
      "mode": "augment",
      "entry": "Main.qml",
      "settings": {
        "barCount": {
          "type": "integer",
          "control": "slider",
          "label": "Bar count",
          "default": 88,
          "minimum": 24,
          "maximum": 144,
          "step": 4
        },
        "height": {
          "type": "integer",
          "control": "slider",
          "label": "Visualizer height",
          "default": 280,
          "minimum": 80,
          "maximum": 420,
          "step": 10
        },
        "bottomMargin": {
          "type": "integer",
          "control": "slider",
          "label": "Bottom margin",
          "default": 0,
          "minimum": 0,
          "maximum": 240,
          "step": 4
        },
        "opacity": {
          "type": "number",
          "control": "slider",
          "label": "Opacity",
          "default": 0.86,
          "minimum": 0.15,
          "maximum": 1,
          "step": 0.01
        },
        "sensitivity": {
          "type": "number",
          "control": "slider",
          "label": "Volume sensitivity",
          "default": 2.4,
          "minimum": 0.4,
          "maximum": 4,
          "step": 0.1
        },
        "mirror": {
          "type": "boolean",
          "control": "toggle",
          "label": "Mirror wave profile",
          "default": true
        }
      }
    }
  ]
}

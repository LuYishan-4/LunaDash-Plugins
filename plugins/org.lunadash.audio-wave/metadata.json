{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.lunadash.audio-wave",
  "name": "Audio Wave",
  "name[zh_TW]": "音訊波浪",
  "description": "Large desktop-output spectrum with adaptive gain, distinct frequency peaks and frame-synchronized motion. Requires the LunaDash audio-spectrum helper and parec.",
  "description[zh_TW]": "大幅度桌面播放頻譜，具自動增益、明顯頻帶起伏與逐幀平滑動態。需要 LunaDash audio-spectrum helper 與 parec。",
  "version": "1.0.1a",
  "author": {
    "name": "LunaDash contributors"
  },
  "icon": "audio-x-generic",
  "tags": [
    "Audio",
    "Visualizer",
    "Wallpaper",
    "Desktop"
  ],
  "enabledByDefault": false,
  "targets": [
    {
      "id": "desktop-widgets",
      "type": "quickshell",
      "target": "desktop-widgets",
      "mode": "augment",
      "entry": "Main.qml",
      "settings": {
        "barCount": {
          "type": "integer",
          "control": "slider",
          "label": "Bar count",
          "default": 88,
          "minimum": 24,
          "maximum": 144,
          "step": 4
        },
        "height": {
          "type": "integer",
          "control": "slider",
          "label": "Visualizer height",
          "default": 320,
          "minimum": 80,
          "maximum": 720,
          "step": 10
        },
        "bottomMargin": {
          "type": "integer",
          "control": "slider",
          "label": "Bottom margin",
          "default": 0,
          "minimum": 0,
          "maximum": 240,
          "step": 4
        },
        "opacity": {
          "type": "number",
          "control": "slider",
          "label": "Opacity",
          "default": 0.86,
          "minimum": 0.15,
          "maximum": 1,
          "step": 0.01
        },
        "sensitivity": {
          "type": "number",
          "control": "slider",
          "label": "Spectrum gain",
          "default": 2.4,
          "minimum": 0.4,
          "maximum": 6,
          "step": 0.1
        },
        "mirror": {
          "type": "boolean",
          "control": "toggle",
          "label": "Mirror wave profile",
          "default": true
        },
        "amplitudeScale": {
          "type": "number",
          "control": "slider",
          "label": "Wave amplitude",
          "default": 1.8,
          "minimum": 0.5,
          "maximum": 3,
          "step": 0.1
        },
        "autoGain": {
          "type": "boolean",
          "control": "toggle",
          "label": "Normalize quiet playback",
          "default": true
        },
        "barSpacing": {
          "type": "integer",
          "control": "slider",
          "label": "Bar spacing",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "step": 1
        }
      }
    }
  ]
}

{
  "schemaVersion": 2,
  "sdk": {
    "name": "LunaDash",
    "apiVersion": 2
  },
  "id": "org.lunadash.kde-behavior",
  "name": "KDE Behavior Pack",
  "description": "Caelestia-inspired KDE taskbar capsules, occupied-workspace navigation, freeform stacking windows, window rules and animations for LunaDash.",
  "version": "1.1.0",
  "author": {
    "name": "LunaDash contributors"
  },
  "icon": "preferences-desktop",
  "tags": [
    "KDE",
    "Panel",
    "Freeform",
    "Windows",
    "Animation",
    "Multi-target"
  ],
  "enabledByDefault": false,
  "targets": [
    {
      "id": "panel",
      "type": "quickshell",
      "target": "panel",
      "mode": "replace",
      "entry": "KdePanel.qml",
      "settings": {
        "compact": {
          "type": "boolean",
          "control": "toggle",
          "label": "Compact task buttons",
          "default": true
        },
        "showLabels": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show window titles",
          "default": false
        },
        "showWorkspaceSwitcher": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show workspace switcher",
          "default": true
        },
        "showSystemTray": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show system tray",
          "default": true
        },
        "showStatus": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show status controls",
          "default": true
        },
        "showClock": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show clock",
          "default": true
        },
        "iconSize": {
          "type": "integer",
          "control": "slider",
          "label": "Dock icon size",
          "default": 22,
          "minimum": 16,
          "maximum": 32,
          "step": 1
        },
        "panelOpacity": {
          "type": "number",
          "control": "slider",
          "label": "Capsule opacity",
          "default": 0.88,
          "minimum": 0.45,
          "maximum": 1,
          "step": 0.01
        },
        "showDashboard": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show dashboard button",
          "default": true
        },
        "occupiedWorkspacesOnly": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show occupied workspaces only",
          "default": true
        },
        "workspaceScroll": {
          "type": "boolean",
          "control": "toggle",
          "label": "Scroll workspace capsule to switch",
          "default": true
        },
        "volumeScroll": {
          "type": "boolean",
          "control": "toggle",
          "label": "Scroll volume status to adjust",
          "default": true
        },
        "showPowerButton": {
          "type": "boolean",
          "control": "toggle",
          "label": "Show power button with workspaces",
          "default": true
        }
      }
    },
    {
      "id": "window-layout",
      "type": "effect",
      "target": "window-layout",
      "mode": "replace",
      "entry": "liblunadash-kde-behavior.so",
      "windowTemplate": "stacking",
      "settings": {
        "placement": {
          "type": "string",
          "control": "select",
          "label": "New window placement",
          "default": "cascade",
          "enum": [
            "cascade",
            "center"
          ]
        },
        "cascadeOffset": {
          "type": "integer",
          "control": "slider",
          "label": "Cascade offset",
          "default": 28,
          "minimum": 0,
          "maximum": 80,
          "step": 1
        },
        "edgePadding": {
          "type": "integer",
          "control": "slider",
          "label": "Window edge padding",
          "default": 24,
          "minimum": 0,
          "maximum": 96,
          "step": 2
        },
        "resetCascadeWhenEmpty": {
          "type": "boolean",
          "control": "toggle",
          "label": "Restart cascade on an empty workspace",
          "default": true
        }
      }
    },
    {
      "id": "window-rules",
      "type": "effect",
      "target": "window-rules",
      "mode": "replace",
      "entry": "liblunadash-kde-behavior.so",
      "settings": {
        "workspacePolicy": {
          "type": "string",
          "control": "select",
          "label": "New-window workspace policy",
          "default": "current",
          "enum": [
            "current",
            "first",
            "remember"
          ]
        },
        "maximizeNewWindows": {
          "type": "boolean",
          "control": "toggle",
          "label": "Maximize new windows",
          "default": false
        }
      }
    },
    {
      "id": "window-animation",
      "type": "effect",
      "target": "window-animation",
      "mode": "replace",
      "entry": "liblunadash-kde-behavior.so",
      "settings": {
        "duration": {
          "type": "integer",
          "control": "number",
          "label": "Animation duration",
          "default": 180,
          "minimum": 0,
          "maximum": 600,
          "step": 10
        },
        "enterOffset": {
          "type": "integer",
          "control": "number",
          "label": "Opening offset",
          "default": 6,
          "minimum": -100,
          "maximum": 100,
          "step": 1
        },
        "focusOpacity": {
          "type": "number",
          "control": "slider",
          "label": "Unfocused opacity",
          "default": 0.96,
          "minimum": 0,
          "maximum": 1,
          "step": 0.01
        },
        "exitScale": {
          "type": "number",
          "control": "slider",
          "label": "Closing scale",
          "default": 0.97,
          "minimum": 0.5,
          "maximum": 1,
          "step": 0.01
        },
        "easing": {
          "type": "string",
          "control": "select",
          "label": "Easing curve",
          "default": "outCubic",
          "enum": [
            "linear",
            "outCubic",
            "outQuint",
            "inOutCubic"
          ]
        }
      }
    }
  ]
}
